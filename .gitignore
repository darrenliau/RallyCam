# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios/*
!/ios/ci_scripts/

# made by the @bacons/apple-targets plugin on every prebuild (the watch app's Swift files and expo-target.config.js are what is kept)
/targets/*/Assets.xcassets/
/targets/*/Info.plist
/android

__pycache__/
*.pyc

.env
