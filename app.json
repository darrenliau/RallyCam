{
  "expo": {
    "name": "RallyCam",
    "slug": "rallycam",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.darrenliau.rallycam",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.darrenliau.rallycam"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "rallycam",
    "backgroundColor": "#0B1210",
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "RallyCam records your badminton matches with the camera.",
          "microphonePermission": "RallyCam uses the microphone to hear racket hits and record match audio.",
          "recordAudioAndroid": true
        }
      ],
      "expo-sqlite",
      "expo-video",
      "expo-screen-orientation"
    ]
  }
}
